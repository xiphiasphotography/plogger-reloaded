# Explicit legacy application report; no blanket suppression or generated baseline.
includes:
    - phpstan.neon

parameters:
    paths:
        - plogger.php
        - plog-load-config.php
        - plog-globals.php
        - plog-admin
        - plog-includes/plog-functions.php
        - plog-includes/plog-auth.php
        - plog-includes/plog-security.php
        - plog-includes/plog-assets.php
        - plog-includes/lib/gettext/plural.php
        - plog-includes/plog-csrf.php
        - plog-includes/plog-database.php
        - plog-includes/plog-upgrade.php
        - plog-includes/plog-upgrade-config.php
        - plog-includes/plog-schema.php
        - plog-includes/plog-theme-check.php
        - plog-includes/plog-metadata.php
        - plog-includes/plog-import.php
        - plog-includes/plog-zip.php
        - plog-includes/plog-tag-functions.php
        - plog-download.php
        - plog-thumb.php
        - plog-remote.php
    scanDirectories:
        - plog-includes/lib
