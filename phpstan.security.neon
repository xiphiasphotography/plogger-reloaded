# Blocking level-6 checks for the shared security boundaries; no baseline.
includes:
    - phpstan.neon
parameters:
    paths:
        - plog-includes/plog-auth.php
        - plog-includes/plog-security.php
        - plog-includes/plog-assets.php
        - plog-includes/plog-ui.php
        - plog-includes/plog-csrf.php
        - plog-includes/plog-database.php
        - plog-includes/plog-metadata.php
        - plog-includes/plog-import.php
        - plog-includes/plog-zip.php
        - plog-includes/plog-upgrade.php
        - plog-includes/plog-upgrade-config.php
        - plog-includes/plog-schema.php
        - plog-includes/plog-theme-check.php
        - plog-includes/plog-extensions.php
        - plog-includes/plog-dimensions.php
        - plog-content/modules/oypo/module.php
        - plog-admin/dimensions-cli.php
        - plog-admin/plog-dimensions.php
        - plog-admin/_upgrade.php
        - plog-admin/upgrade-cli.php
        - plog-includes/lib/gettext/plural.php
    scanFiles:
        - plog-admin/plog-admin.php
        - plog-includes/plog-functions.php
        - plog-globals.php
        - plog-config-sample.php
        - plog-includes/plog-zip.php
        - plog-includes/lib/gettext/gettext.php
        - plog-includes/lib/gettext/streams.php
