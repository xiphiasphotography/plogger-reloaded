{
    "name": "xiphiasphotography/plogger-reloaded",
    "description": "Development tooling for the Plogger Reloaded PHP gallery",
    "type": "project",
    "require-dev": {
        "php": ">=8.1 <8.5",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "config": {"sort-packages": true, "allow-plugins": false},
    "scripts": {
        "lint": "@php tools/lint.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "analyse:security": "phpstan analyse --configuration=phpstan.security.neon --memory-limit=512M --no-progress",
        "analyse:application": "phpstan analyse --configuration=phpstan.application.neon --memory-limit=512M --no-progress",
        "check": ["@lint", "@test", "@analyse", "@analyse:security"]
    }
}
